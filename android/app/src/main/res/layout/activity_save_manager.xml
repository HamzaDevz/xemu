<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/save_manager_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/setup_wizard_background"
  android:orientation="vertical"
  android:paddingHorizontal="@dimen/top_level_card_outer_padding_horizontal"
  android:paddingVertical="@dimen/top_level_card_outer_padding_vertical">

  <com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/xemu_surface"
    app:cardCornerRadius="28dp"
    app:cardElevation="14dp"
    app:strokeColor="@color/xemu_outline"
    app:strokeWidth="2dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:paddingHorizontal="24dp"
      android:paddingTop="24dp">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_manager_title"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" />

      <TextView
        android:id="@+id/tv_save_manager_storage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/xemu_text_muted" />

      <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_save_manager_storage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="1000"
        app:indicatorColor="@color/xemu_green"
        app:trackColor="@color/xemu_surface_container_high"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btn_save_manager_import"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/save_manager_import"
          android:textColor="@color/xemu_black"
          app:icon="@drawable/ic_xemu_upload_file"
          app:iconGravity="textStart"
          app:iconPadding="8dp"
          app:iconTint="@color/xemu_black" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btn_save_manager_export_all"
          style="@style/Widget.Xemu.Button.Outlined.Pill"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:layout_weight="1"
          android:text="@string/save_manager_export_all" />
      </LinearLayout>

      <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_save_manager_busy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/xemu_green"
        app:trackColor="@android:color/transparent" />

      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/recycler_save_titles"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:clipToPadding="false"
          android:paddingBottom="16dp" />

        <TextView
          android:id="@+id/tv_save_manager_empty"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="32dp"
          android:gravity="center"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
          android:textColor="@color/xemu_text_muted"
          android:visibility="gone" />
      </FrameLayout>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
</LinearLayout>
