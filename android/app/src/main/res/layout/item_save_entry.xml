<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="?attr/selectableItemBackground"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingVertical="8dp">

  <ImageView
    android:id="@+id/img_save_entry_icon"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="@drawable/game_list_cover_background"
    android:contentDescription="@null"
    android:scaleType="fitCenter" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/tv_save_entry_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="2"
      android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

    <TextView
      android:id="@+id/tv_save_entry_details"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textAppearance="@style/TextAppearance.Material3.BodySmall"
      android:textColor="@color/xemu_text_muted" />
  </LinearLayout>

  <ImageButton
    android:id="@+id/btn_save_entry_menu"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:contentDescription="@string/save_manager_save_actions"
    android:padding="8dp"
    android:src="@drawable/ic_xemu_more_vert"
    app:tint="@color/xemu_text_muted" />
</LinearLayout>
